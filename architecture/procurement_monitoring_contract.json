{
  "version": "1.0",
  "status": "phase_2i_bounded_monitoring_foundation",
  "requirements": {
    "cursor_based": false,
    "idempotent_polling": true,
    "deduplicate_by_provider_id_and_external_id": true,
    "change_detection_by_fingerprint": true,
    "explicit_new_vs_changed": true,
    "future_plan_vs_active_procedure_distinguished": true,
    "operator_visible_source_provenance": true,
    "page_offset_polling": true,
    "fingerprint_change_detection": true,
    "stable_order_required_for_incremental_monitoring": true,
    "watermark_or_overlap_window_required_for_production_incremental_watch": true,
    "durable_checkpoint_required_before_production_schedule": true
  },
  "integration_flow": [
    "bounded_page_poll",
    "observation_normalization",
    "provider_external_id_deduplication",
    "fingerprint_change_detection",
    "freshness_checkpoint_or_overlap_window",
    "existing_identity_resolution",
    "evidence",
    "qualification",
    "contact_preparation"
  ],
  "safety": {
    "provider_output_is_not_canonical_identity": true,
    "no_duplicate_client_creation": true,
    "no_automatic_tender_submission": true,
    "no_live_ci_provider_traffic": true,
    "no_offset_only_claim_of_complete_monitoring": true,
    "no_false_cursor_semantics": true
  }
}
