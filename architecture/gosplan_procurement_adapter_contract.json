{
  "version": "1.0",
  "status": "phase_2i_controlled_procurement_api_foundation",
  "provider_id": "gosplan_eis_v2",
  "provider": "ГосПлан API v2",
  "upstream_source": "Единая информационная система в сфере закупок (ЕИС)",
  "execution": {
    "default_enabled": false,
    "live_ci_traffic": false,
    "network_execution_requires_explicit_activation": true,
    "credential_source": "deployment_configuration_only"
  },
  "api": {
    "protocol": "HTTPS REST",
    "product_base": "https://v2.gosplan.info",
    "test_base": "https://v2test.gosplan.info",
    "auth_header": "apikey",
    "collections": {
      "44fz_purchases": "/fz44/purchases",
      "44fz_plans": "/fz44/tenderplans",
      "223fz_purchases": "/fz223/purchases",
      "223fz_plans": "/fz223/purchaseplans",
      "pprf615_purchases": "/pprf615/purchases"
    },
    "pagination": {
      "limit": true,
      "skip": true
    },
    "documented_lookup_key": "regNumber"
  },
  "provider_limits": {
    "production_requests_per_minute": 600,
    "production_tariff": "3000_RUB_PER_MONTH_as_currently_documented",
    "test_requests_per_minute": 10,
    "test_cost": "free"
  },
  "documented_error_classes": {
    "401": "MISSING_OR_INVALID_API_KEY",
    "403": "API_KEY_FORBIDDEN",
    "429": "PROVIDER_RATE_LIMIT",
    "5xx": "PROVIDER_INTERNAL_ERROR"
  },
  "application_controls": {
    "timeout_bounded": true,
    "response_size_bounded": true,
    "retry_bounded": true,
    "provider_filter_passthrough_requires_current_swagger_contract": true,
    "no_html_scraping_fallback": true
  },
  "data_governance": {
    "provider_output_is_canonical_truth": false,
    "provider_output_role": "procurement_observation",
    "identity_linking": "existing_identity_and_evidence_rules_only",
    "source_provenance_required": true
  },
  "non_goals": [
    "automatic_tender_submission",
    "canonical_identity_promotion",
    "new_business_system_of_record",
    "unbounded_crawling",
    "implicit_provider_fallback",
    "html_scraping_fallback"
  ]
}
