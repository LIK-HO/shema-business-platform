{
  "version": "1.0",
  "scope": "intelligence_identity_benchmark",
  "status": "permanent_synthetic_baseline",
  "policy": {
    "synthetic_data_only": true,
    "no_personal_data": true,
    "no_live_source_lookup": true,
    "no_automatic_identity_promotion": true,
    "ground_truth_required_for_precision_recall": true
  },
  "measurement": {
    "metrics": [
      "precision",
      "recall",
      "false_positive_rate",
      "false_negative_rate",
      "provenance_completeness",
      "freshness_correctness",
      "operator_correction_rate"
    ],
    "decision_rule": "benchmark outputs never mutate canonical identity state",
    "minimum_case_classes": [
      "exact_identifier_match",
      "same_name_different_entity",
      "old_identifier",
      "changed_registration",
      "duplicate_sources",
      "contradictory_claims",
      "stale_claim",
      "missing_identifier",
      "misleading_near_match"
    ]
  },
