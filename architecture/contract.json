{
  "version": "1.2",
  "product": "Commercial Intelligence & Execution OS",
  "runtime": "modular_monolith",
  "transactional_authority": "postgresql",
  "layers": {
    "experience": [],
    "application": ["domain", "foundation"],
    "domain": ["foundation"],
    "foundation": [],
    "adapters": ["application", "domain", "foundation"],
    "platform": []
