    "candidate",
    "identified",
    "verified",
    "active",
    "inactive",
    "unknown"
  ],
  "quality_gates": [
    "architecture_contract",
    "lint",
    "compile",
    "unit_tests",
    "integration_tests",
    "security_tests",
    "recovery_drills",
    "controlled_release"
