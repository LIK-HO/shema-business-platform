{
  "version": "1.0",
  "status": "strategic_boundary_contract",
  "purpose": "Safe handoff from Shema intelligence and preparation into a mature external business control plane.",
  "frozen_kernel_impact": false,
  "domain_ownership": {
    "shema": [
      "identity_resolution",
      "evidence",
      "provenance",
      "freshness",
      "qualification",
      "contact_preparation",
      "temporary_live_repeat_orders_before_bitrix_handoff",
      "ai_run_lineage",
      "learning_context",
      "communication_preparation"
    ],
    "bitrix24_after_handoff": [
      "live_crm_state",
      "deal_and_order_lifecycle",
      "transaction_price",
      "invoice_and_payment_state",
      "business_economics",
      "customer_communication_history",
      "assignment_and_team_processes",
      "customer_outbound_communication_execution"
    ],
    "forbidden_dual_ownership": [
      "transaction_price",
      "live_deal_stage",
      "live_order_status",
      "invoice_state",
      "payment_state",
      "business_margin",
      "customer_communication_history",
      "customer_outbound_communication_execution"
    ]
  },
  "handoff_state_machine": [
    "PREPARED",
    "OUTBOX_RESERVED",
    "SENT_UNKNOWN",
    "ACKNOWLEDGED",
    "RECONCILIATION_REQUIRED",
    "HANDOFF_FAILED",
    "CANCELLED"
  ],
  "handoff_identity": {
    "stable_handoff_id_required": true,
    "stable_idempotency_key_pattern": "bitrix-handoff:{handoff_id}",
    "mapping_version_required": true,
    "payload_hash_required": true,
    "correlation_id_required": true,
    "shema_identity_reference_required": true,
    "external_entity_reference_required_after_ack": true
  },
  "delivery": {
    "outbox_required": true,
    "external_call_outside_core_transaction": true,
    "at_least_once_delivery": true,
    "duplicate_safe_consumer_required": true,
    "same_key_different_payload_must_fail_closed": true,
    "lost_response_requires_reconciliation_before_retry": true,
    "no_blind_replay_of_unknown_business_effect": true
  },
  "ownership_transfer": {
    "handoff_does_not_delete_shema_history": true,
    "bitrix_becomes_live_business_authority_only_after_acknowledged_handoff": true,
    "shema_stores_reference_and_minimal_outcome_lineage": true,
    "same_live_field_is_never_written_by_both_systems": true,
    "reconciliation_can_quarantine_inconsistent_mapping": true
  },
  "minimum_handoff_payload": [
    "identity_reference",
    "company_or_contact_reference",
    "qualification_state",
    "evidence_references",
    "contact_preparation",
    "repeat_business_preparation_if_any",
    "correlation_reference"
  ],
  "data_minimization": {
    "no_full_crm_mirror": true,
    "no_full_finance_mirror": true,
    "no_executor_personnel_dataset_by_default": true,
    "no_raw_secret_transfer": true,
    "only_outcome_features_return_to_shema_by_default": true
  },
  "learning_return": {
    "stable_external_event_id_required": true,
    "mapping_version_required": true,
    "outcome_semantics_versioned": true,
    "historical_outcomes_are_append_only": true,
    "corrections_are_events_not_overwrites": true,
    "full_crm_replication_disabled_by_default": true
  },
  "repeat_business": {
    "shema_role_before_bitrix": "execute_bounded_repeat_orders_and_revalidate_current_context",
    "shema_role_after_bitrix": "preparation_only_then_frozen_hidden_after_migration",
    "bitrix_role_after_handoff": "live_repeat_and_recurring_transaction_execution",
    "temporary_local_mode_is_allowed": true,
    "local_mode_uses_frozen_order_economics_semantics": true,
    "no_dual_live_ownership": true,
    "shema_must_not_reimplement_bitrix_recurring_deal_engine": true
  },
  "economics": {
    "shema_role": "optional_coarse_outcome_features_for_learning",
    "bitrix_role_after_handoff": "live_transaction_economics",
    "frozen_shema_economics_role": "compatibility_and_historical_lineage_only",
    "no_new_live_accounting_subsystem_in_shema": true
  },
  "failure_policy": {
    "provider_or_crm_unavailable": "retain_prepared_handoff_and_retry_boundedly",
    "unknown_external_effect": "reconciliation_required",
    "mapping_drift": "fail_closed_and_manual_review",
    "permission_failure": "fail_closed",
    "schema_or_contract_mismatch": "fail_closed"
  },
  "communication": {
    "shema_role": "prepare context and optional operator/internal notification",
    "bitrix24_or_business_plane_after_handoff": "authoritative customer-facing communication execution and history",
    "max_direct_customer_outbound_from_shema": "disabled_by_default",
    "max_customer_outbound_requires": "explicit_provider_safety_and_business_plane_reconciliation_contract"
  },
  "order_economics_transition": {
    "migration_mode": "full_transaction_history_transfer_then_purge_live_shema_rows",
    "contract": "architecture/repeat_order_transition_contract.json",
    "full_transfer_required": true,
    "purge_only_after_verified_readback": true,
    "frozen_lineage_tombstone_required": true,
    "ui_capability_hide_after_purge": true,
    "no_stale_deep_links": true
  },
  "bitrix_business_plane_stack": {
    "crm_core": "native_bitrix24_crm",
    "custom_workflows": "bitrix24_smart_process_automation_when_available",
    "assignments_and_team_work": "bitrix24_tasks_automation_and_permissions_when_available",
    "inventory_and_product_economics": "bitrix24_inventory_and_product_catalog_when_available",
    "documents_and_signing": "bitrix24_crm_documents_and_signing_when_available",
    "routing_and_logistics": "bitrix24_spa_or_external_specialist_integration_selected_by_capability_detection",
    "executors": "bitrix24_users_departments_roles_and_task_assignment_or_specialist_integration",
    "tenders": "external_tender_platform_or_approved_bitrix24_market_integration; never reimplemented in shema",
    "accounting_authority": "external_accounting_or_finance_system_if_required; bitrix24 remains business-plane coordinator",
    "capability_detection_required": true
  },
  "full_history_transfer": {
    "enabled_only_for_transaction_migration": true,
    "package_contract": "architecture/repeat_order_transition_contract.json",
    "includes_order_economics_and_required_client_history": true,
    "excludes_secrets_and_unrelated_security_telemetry": true,
    "readback_verification_required": true
  },
  "operator_continuity": {
    "interface_contract": "architecture/operator_interface_contract.json"
  }
}
